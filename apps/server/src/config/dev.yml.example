# 开发环境配置模板（复制为 dev.yml 并填入真实密钥）
# 生产部署目录结构（与 prod.yml、upload 同级，部署 rsync 不覆盖）：
#   /www/wwwroot/ll_api/prod.yml   — 生产配置
#   /www/wwwroot/ll_api/upload/    — 用户上传（app.file.location: '../upload'）
#   /www/wwwroot/ll_api/data/      — 运行时日志（Winston / PM2 / TypeORM，见 runtime-paths.ts）
app:
  prefix: ''
  port: 6060
  file:
    isLocal: true
    location: '../upload'
    domain: 'http://127.0.0.1:6060'
    serveRoot: '/upload'
    maxSize: 10

db:
  mysql:
    host: '127.0.0.1'
    username: 'root'
    password: 'your_password'
    database: 'your_database'
    port: 3306
    charset: 'utf8mb4'
    timezone: '+08:00'
    logging: true
    logger: 'file'  # 开发：apps/server/ormlogs.log；生产：../data/ormlogs.log（见 runtime-paths.ts）
    multipleStatements: true
    dropSchema: false
    synchronize: false

redis:
  host: '127.0.0.1'
  password: 'your_redis_password'
  port: 6379
  db: 1
  keyPrefix: ''

jwt:
  secretkey: 'your_secretkey'

wechat:
  appId: 'your_wechat_appid'
  appSecret: 'your_wechat_appsecret'

perm:
  router:
    whitelist:
      - { path: '/captchaImage', method: 'GET' }
      - { path: '/register', method: 'POST' }
      - { path: '/login', method: 'POST' }
      - { path: '/wxLogin', method: 'POST' }
      - { path: '/auth/wxLogin', method: 'POST' }
      - { path: '/refreshToken', method: 'POST' }
      - { path: '/common/area/trees', method: 'GET' }
      - { path: '/common/upload', method: 'POST' }
      - { path: '/tasks', method: 'POST' }
      - { path: '/tasks/delete', method: 'GET' }

mail:
  host: 'smtp.example.com'
  port: 465
  secure: true
  auth: { user: 'your@email.com', pass: 'your_mail_password' }

aliyun:
  apiKey: 'your_dashscope_api_key'
  # 兼容模式（chat / VLM）；OCR 原生接口可从该地址推导 api/v1，也可在 ocr.baseUrl 单独指定
  baseUrl: 'https://dashscope.aliyuncs.com/compatible-mode/v1'
  model: 'qwen3.7-plus'   # 通用 LLM（非 OCR/VLM）
  timeout: 180000
  # 工资条 OCR（Qwen advanced_recognition，走原生 multimodal-generation）
  ocr:
    model: qwen3.5-ocr
    task: advanced_recognition
    enableRotate: true
    # timeout: 180000          # 未配则用 aliyun.timeout
    # baseUrl: ''              # 可选；未配时从 aliyun.baseUrl 推导 workspace api/v1
  # 工资条 VLM 结构化抽取（兼容模式 chat/completions + 图片）
  vlm:
    model: qwen3-vl-plus
    # timeout: 120000
    # baseUrl: ''              # 可选；未配则用 aliyun.baseUrl

# 工资条识别编排：主/备路径只在此配置，能力模块互不感知
salarySlip:
  recognize:
    primary: ocr          # vlm | ocr
    fallback: none        # vlm | ocr | none；例：primary: vlm + fallback: ocr
    # fallbackOn:         # 可选，覆盖默认硬失败错误码列表
    #   - vlm_timeout
    #   - ocr_timeout

nowapi:
  host: 'https://sapi.k780.com'
  appkey: 0
  sign: 'your_nowapi_sign'
