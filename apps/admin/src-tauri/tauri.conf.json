{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ccode",
  "version": "0.0.6",
  "identifier": "com.ll.admin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9596",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm run cs:vite-build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ccode",
        "width": 1228,
        "height": 800,
        "minWidth": 1228,
        "minHeight": 800,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://webapi.amap.com https://*.amap.com; style-src 'self' 'unsafe-inline' https://*.amap.com; img-src 'self' data: blob: https: http: asset: http://asset.localhost; media-src 'self' blob: https: http: asset: http://asset.localhost; connect-src 'self' https: http: ws: wss:; font-src 'self' data:; frame-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "resources/icloud-sync-agent.exe",
      "resources/ffmpeg.exe",
      "resources/ffprobe.exe"
    ]
  }
}
